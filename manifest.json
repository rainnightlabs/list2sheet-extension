{
  "manifest_version": 3,
  "name": "List2Sheet – Web Scraper to Excel & CSV",
  "version": "0.13.4",
  "description": "Extract tables, lists, products, comments and search results from webpages to Excel, CSV, JSON and XLSX.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "List2Sheet",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "license.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.rainnightlabs.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
