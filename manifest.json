{
  "manifest_version": 3,
  "name": "List2Sheet",
  "version": "0.13.1",
  "description": "Turn web posts, comments, products, lists, search results, and tables into clean spreadsheet data.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "List2Sheet",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "license.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.rainnightlabs.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
