{
  "manifest_version": 3,
  "name": "List2Sheet",
  "version": "0.4.0",
  "description": "Turn web tables, lists, and repeated cards into clean structured data.",
  "action": {
    "default_title": "List2Sheet",
    "default_popup": "popup.html"
  },
  "options_page": "license.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.rainnightlabs.com/*"
  ]
}